---
layout: default
---
{% comment %}
  LOCAL OVERRIDE of al_folio_core's _layouts/about.liquid.
  Top of the page is the Mossy Modernist hero (2-column split). The rest
  (news, selected publications, social) is preserved from the gem layout so
  homepage behavior is unchanged. Styling lives in _sass/_mossy.scss.
{% endcomment %}
<div class="post">
  <header class="mossy-hero">
    <div class="mossy-hero__left">
      {% if page.subtitle %}
        {%- comment -%}
          Split the subtitle on the dot so each segment (role / department /
          university) stays intact and can only wrap at a separator, never
          mid-affiliation. Small-screen wrapping is relaxed in _mossy.scss.
        {%- endcomment -%}
        <p class="mossy-eyebrow">
          {%- assign eyebrow_parts = page.subtitle | split: "·" -%}
          {%- for part in eyebrow_parts -%}
            <span class="mossy-eyebrow__part">{{ part | strip }}</span>{%- unless forloop.last %} <span class="mossy-eyebrow__sep" aria-hidden="true">·</span> {% endunless -%}
          {%- endfor -%}
        </p>
      {% endif %}

      <h1 class="mossy-hero__name">
        {% if site.title == 'blank' %}
          {{ site.first_name }} {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>

      <div class="mossy-hero__bio">{{ content }}</div>

      {% if page.current %}
        <div class="mossy-current">
          <span class="mossy-current__dot" aria-hidden="true"></span>
          <div>
            <span class="mossy-current__label">Currently</span>
            <p class="mossy-current__text">{{ page.current }}</p>
          </div>
        </div>
      {% endif %}
    </div>

    {% if page.profile %}
      <div class="mossy-hero__right">
        <div class="mossy-hero__panel">
          {% if page.profile.image %}
            {% comment %} Accepts both the bare-filename form (al-folio default) and the
            full assets/img/ path the /admin editor writes. {% endcomment %}
            {% assign profile_image_path = page.profile.image | remove_first: 'assets/img/' | prepend: 'assets/img/' %}
            {% comment %} The orange panel renders ~430px wide on desktop; asking for 480px
            keeps scaled Windows displays (125-150%) on the sharp 800w variant instead of
            the 480w one. {% endcomment %}
            {% capture sizes %}(min-width: 768px) 480px, 85vw{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class="mossy-portrait"
              sizes=sizes alt="Portrait of Madison Rittinger" cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="mossy-hero__meta">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </header>

  <article>
    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="mossy-section">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="mossy-section">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
      <!-- Photo credits on the selected-publication thumbnails, same treatment as
           the Publications page (shared include so they match exactly). -->
      {% include publication-credits.html %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
